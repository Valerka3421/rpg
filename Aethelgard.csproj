<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>CS8618;CS8632;CS0169;CS0649;CS0219;CA1416</NoWarn>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Aethelgard</AssemblyName>
    <RootNamespace>Aethelgard</RootNamespace>
    <Version>0.2.0</Version>
    <Company>Valerka3421</Company>
    <Product>Aethelgard</Product>
    <Description>Tactical RPG — refactored layered architecture (BaseClass/Entities/Structs/World/Systems/Data)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>

  <!-- System.Drawing for runtime font rendering (replaces MGCB content pipeline) -->
  <ItemGroup>
    <!-- RuntimeFont: рантайм-генерация шрифта. Работает на Windows;
         на Linux сборка проходит, рендер шрифта деградирует в заглушку. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Игровые данные перенесены из data/*.json в C#-классы (Data/*Defs.cs) -->

  <!-- Тестовый проект лежит в tests/ и не должен попадать в игру -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
