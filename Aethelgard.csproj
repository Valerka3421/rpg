<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8618;CS8632;CS0169;CS0649;CS0219;CA1416</NoWarn>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Aethelgard</AssemblyName>
    <RootNamespace>Aethelgard</RootNamespace>
    <Version>0.3.0</Version>
    <Company>Valerka3421</Company>
    <Product>Aethelgard</Product>
    <Description>Tactical RPG — refactored layered architecture (BaseClass/Entities/Structs/World/Systems/Data)</Description>
    <!-- Unity-проект не должен попадать в дефолтную глоб-компиляцию:
         ядро подключается линком явно, движковый слой Unity — никогда -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Unity/**;Library/**;Temp/**;Logs/**;obj/**;UserSettings/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>

  <!-- Шрифты DejaVu (свободная лицензия) копируются рядом со сборкой -->
  <ItemGroup>
    <None Include="Content/fonts/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Иконки навыков и спрайты копируются рядом со сборкой -->
  <ItemGroup>
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Игровые данные перенесены из data/*.json в C#-классы (Data/*Defs.cs) -->

  <!-- Тестам нужен доступ к internal-таблицам данных (Data/*Defs) для
       валидатора ссылочной целостности -->
  <ItemGroup>
    <InternalsVisibleTo Include="Aethelgard.Tests" />
  </ItemGroup>

  <!-- Тестовый проект лежит в tests/ и не должен попадать в игру -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- Unity-проект лежит внутри репо (Unity/). В MonoGame-сборку включается
       ТОЛЬКО чистое ядро (Unity/Assets/Scripts/Core), кроме Compat/:
       shim подменяет Microsoft.Xna.Framework на Unity-версии и использует
       UnityEngine, недоступный здесь; GlobalUsings ядра не дублирует
       корневой. Движковый слой Unity (Unity/Assets/Scripts/Game) в
       MonoGame-сборку не попадает. -->
  <ItemGroup>
    <Compile Include="Unity/Assets/Scripts/Core/**/*.cs" Exclude="Unity/Assets/Scripts/Core/Compat/**;Unity/Assets/Scripts/Core/GlobalUsings.cs" />
  </ItemGroup>
</Project>
