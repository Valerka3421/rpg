# EditorConfig — https://editorconfig.org
# Настройки общие для всех редакторов и IDE.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{py,pyi}]
# Python: 4 пробела, как PEP 8
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{md,markdown}]
# Markdown: сохраняем trailing whitespace (два пробела = перенос строки)
trim_trailing_whitespace = false
max_line_length = off

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
